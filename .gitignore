node_modules/
dist/
.DS_Store
*.log

# Raw data — too large for git (download via tools/download_data.sh)
data/raw/
data/*.feather
data/*.npy
data/*.tsv

# Built brain blob — regenerable via tools/build_csr.py
public/brain.bin
public/brain.meta.json

# Built spine blob — regenerable via tools/build_vnc.py
public/vnc.bin
public/vnc.meta.json

# MANC raw downloads (Janelia public bucket; tools/download_manc.sh)
data/manc/

# Asset version manifest — regenerable via tools/write_manifest.py.
# Maps asset filename → 12-char sha used for cache-busting binary URLs.
public/assets.json

# Dallmann 2026 supplementary table 1 — manually downloaded from biorxiv.
data/raw/dallmann_2026/

# Trained walking policy + raw flybody policy SavedModels.
# Regen: download trained-fly-policies.zip from janelia.figshare,
# unzip into data/flybody-policies/, run tools/extract_walking_policy.py.
public/walking-policy.bin
data/flybody-policies/

# TF venv (1.4 GB; kept out of repo)
.venv-tf/
# flybody-only Python venv (no TF; for tools/dump_flybody_spec.py)
.venv-flygym/

# Derived: per-channel obs normalizer + canonical env spec dump,
# both regenerable via tools/dump_flybody_spec.py
public/walking-obs-norm.bin
data/flybody-spec.json

# Real-fly walking reference trajectory baked from the Janelia mocap
# dataset (Vaxenburg 2025 Figshare 25309105). Regenerable via
# tools/bake_walking_ref.py from data/raw/flybody-mocap/.
public/walking-ref.bin
data/raw/flybody-mocap/

# flybody assets — vendored from TuragaLab/flybody main (149 MB)
public/flybody/*.obj
public/flybody/meshes.txt
# Concatenated bundle of flybody assets (140 MB), regenerable via
# tools/bake_flybody_bundle.py. Read by physics.ts in one IDB
# transaction instead of 87 per-file fetches.
public/flybody.bundle.bin

# Snapshots
snapshots/

# Playwright artifacts
/playwright-report/
/test-results/
.env.production
.claude/
